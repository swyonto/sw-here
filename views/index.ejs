<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SW-HERE | Hybrid P2P File Sharing</title>
  <!-- Favicon Logo link -->
  <link rel="icon" type="image/png" href="/images/sw-here-logo.png">
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Core Styles -->
  <link rel="stylesheet" href="/css/style.css">
  <!-- Preload branding logo images for instantaneous theme switching -->
  <link rel="preload" as="image" href="/images/image-dark.png">
  <link rel="preload" as="image" href="/images/sw-here-logo.png">
</head>
<body>
  <!-- Neon Ambient Glowing Background Lights -->
  <div class="ambient-glow-wrapper">
    <div class="ambient-glow bg-glow-indigo"></div>
    <div class="ambient-glow bg-glow-pink"></div>
    <div class="ambient-glow bg-glow-teal"></div>
  </div>

  <!-- App Wrapper -->
  <div class="app-container">
    
    <!-- Top Sleek Header -->
    <header class="app-header">
      <a href="/about" class="brand" title="About SW-HERE" style="text-decoration:none;color:inherit;">
        <div class="brand-logo">
          <img src="/images/image-dark.png" alt="Logo" class="brand-logo-img">
        </div>
        <div class="brand-info">
          <h1 class="brand-name">SW-HERE</h1>
          <span class="brand-badge">HYBRID DIRECT</span>
        </div>
      </a>
      
      <div class="header-actions">
        <!-- Download desktop app button (hidden inside Electron, shown on Web browser) -->
        <a href="/download/windows" id="download-desktop-btn" class="icon-btn-premium hidden" title="Download Windows App">
          <i class="fa-solid fa-download"></i>
        </a>
        <button id="theme-toggle-btn" class="icon-btn-premium" title="Switch Theme">
          <i class="fa-solid fa-moon"></i>
        </button>
        <div class="server-status">
          <span class="status-dot online"></span>
          <span class="status-text">Connected</span>
        </div>
      </div>
    </header>

    <!-- Desktop App Promo Banner (shown on standard Web browsers, hidden inside Electron) -->
    <div id="desktop-app-banner" class="glass-banner hidden">
      <div class="banner-content">
        <i class="fa-solid fa-laptop-code banner-icon"></i>
        <div class="banner-text">
          <span class="banner-title">Get SW-HERE for Windows</span>
          <span class="banner-desc">Share files offline via Wi-Fi hotspot, bypass browser limits, and get higher speeds!</span>
        </div>
      </div>
      <div class="banner-actions">
        <a href="/download/windows" class="btn-premium btn-xs" style="text-decoration: none; padding: 6px 14px; font-size: 0.68rem; display: inline-flex; align-items: center; gap: 6px; border-radius: 8px; font-weight: 700;">
          <i class="fa-solid fa-download"></i> Download App
        </a>
        <button id="close-banner-btn" class="close-icon-btn">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
    </div>

    <!-- Main Dashboard -->
    <main class="dashboard-main">
      
      <!-- Segmented Tab Selector -->
      <div class="tab-segment-control" id="tab-switcher">
        <button class="tab-btn active" data-tab="send">
          <i class="fa-solid fa-paper-plane"></i> Send Files
        </button>
        <button class="tab-btn" data-tab="receive">
          <i class="fa-solid fa-download"></i> Receive Files
        </button>
        <div class="tab-glider"></div>
      </div>

      <!-- Card Container (Glassmorphic Slider) -->
      <div class="dashboard-card-viewport">
        
        <!-- ================= SEND COMPONENT ================= -->
        <div class="dashboard-card tab-content-pane active" id="pane-send">
          
          <!-- State 1: Select Files / Folders -->
          <div class="send-state-zone" id="send-select-state">
            <h2 class="section-title">Prepare Your Transfer</h2>
            <p class="section-subtitle">Drop files, folders or select them directly below to share peer-to-peer.</p>
            
            <!-- Drag & Drop Zone -->
            <div class="dropzone-container" id="dropzone">
              <input type="file" id="file-input" class="hidden-input" multiple>
              <input type="file" id="folder-input" class="hidden-input" webkitdirectory directory multiple>
              
              <div class="dropzone-inner">
                <div class="dropzone-icon-glow">
                  <i class="fa-solid fa-file-shield dropzone-icon"></i>
                </div>
                <h3 class="dropzone-title">Drag & Drop Files Here</h3>
                <p class="dropzone-desc">Supports documents, directories, videos, and multi-file aggregates</p>
                
                <div class="dropzone-actions">
                  <button type="button" class="btn-secondary" id="select-files-btn">
                    <i class="fa-solid fa-files"></i> Select Files
                  </button>
                  <button type="button" class="btn-secondary" id="select-folders-btn">
                    <i class="fa-solid fa-folder-open"></i> Select Folder
                  </button>
                </div>
              </div>
            </div>

            <!-- Instant room creation option for bidirectional transfers -->
            <div class="or-divider" style="display: flex; align-items: center; justify-content: center; margin: 18px 0; gap: 10px;">
              <span style="height: 1px; background: rgba(255,255,255,0.06); flex: 1;"></span>
              <span style="font-size: 0.72rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Or</span>
              <span style="height: 1px; background: rgba(255,255,255,0.06); flex: 1;"></span>
            </div>
            
            <button type="button" class="btn-secondary w-full" id="instant-room-btn" style="justify-content: center; gap: 8px; border: 1px dashed rgba(255,255,255,0.15); background: rgba(255,255,255,0.01); padding: 12px; border-radius: var(--border-radius-md);">
              <i class="fa-solid fa-door-open text-teal"></i> Open Instant Room to Receive
            </button>

            <!-- Staged Files list -->
            <div class="staged-container hidden" id="staged-container">
              <div class="staged-header">
                <h4>Staged Files (<span id="staged-count">0</span>)</h4>
                <button type="button" class="clear-btn" id="clear-staged-btn">Clear All</button>
              </div>
              
              <div class="staged-files-list" id="staged-files-list">
                <!-- Staged files rendered dynamically here -->
              </div>
              
              <div class="staged-summary-bar">
                <div class="staged-total-info">
                  <span class="total-label">Total Volume:</span>
                  <span class="total-val" id="staged-total-size">0.00 KB</span>
                </div>
                
                <button type="button" class="btn-primary btn-glow" id="generate-code-btn">
                  <i class="fa-solid fa-qrcode"></i> Generate Pair Code
                </button>
              </div>
            </div>
          </div>

          <!-- State 2: Active Session & Pairing -->
          <div class="send-state-zone hidden" id="send-pairing-state">
            <h2 class="section-title">Scan or Input Pairing Code</h2>
            <p class="section-subtitle">Share this code or QR with the receiver. Keep this window open.</p>

            <div class="pairing-code-showcase">
              <!-- Digital Pin Blocks -->
              <div class="pairing-digits" id="pairing-pin-container">
                <span class="digit-box">-</span>
                <span class="digit-box">-</span>
                <span class="digit-box">-</span>
                <span class="digit-box">-</span>
              </div>
              
              <button class="btn-copy-pin" id="copy-pin-btn" title="Copy Pin">
                <i class="fa-solid fa-copy"></i> Copy Pin
              </button>
            </div>

            <div class="qr-canvas-holder">
              <div class="qr-glow-frame">
                <div id="qrcode-container" class="qrcode-wrapper">
                  <!-- Generated QR Canvas or Img here -->
                  <div class="qr-loader">
                    <i class="fa-solid fa-circle-notch fa-spin"></i>
                  </div>
                </div>
              </div>
            </div>

            <div class="pairing-waiting-footer">
              <div class="pulsing-beacon">
                <div class="beacon-circle outer"></div>
                <div class="beacon-circle middle"></div>
                <div class="beacon-circle inner"></div>
              </div>
              <p class="waiting-text">Waiting for device connection...</p>
              <button type="button" class="btn-danger-outline" id="cancel-send-session-btn">
                <i class="fa-solid fa-xmark"></i> Cancel Session
              </button>
            </div>
          </div>

        </div>

        <!-- ================= RECEIVE COMPONENT ================= -->
        <div class="dashboard-card tab-content-pane" id="pane-receive">
          
          <div class="receive-state-zone" id="receive-entry-state">
            <h2 class="section-title">Enter Session Pairing Code</h2>
            <p class="section-subtitle">Input the 4-digit session pin generated by the sending device.</p>
            
            <div class="pin-input-board">
              <div class="pin-inputs" id="pin-input-group">
                <input type="text" maxlength="1" pattern="[0-9]*" inputmode="numeric" class="pin-char-field" id="p-1" autocomplete="off">
                <input type="text" maxlength="1" pattern="[0-9]*" inputmode="numeric" class="pin-char-field" id="p-2" autocomplete="off">
                <input type="text" maxlength="1" pattern="[0-9]*" inputmode="numeric" class="pin-char-field" id="p-3" autocomplete="off">
                <input type="text" maxlength="1" pattern="[0-9]*" inputmode="numeric" class="pin-char-field" id="p-4" autocomplete="off">
              </div>
              
              <p class="pin-error-hint hidden" id="pin-error-text">Invalid pairing pin. Try again.</p>

              <button type="button" class="btn-qr-scan w-full" id="open-qr-scanner-btn" title="Scan QR Code with Camera">
                <i class="fa-solid fa-camera"></i> Scan QR Code
              </button>

              <button type="button" class="btn-primary btn-glow w-full mt-md" id="join-session-btn">
                <i class="fa-solid fa-link"></i> Establish Connection
              </button>
            </div>

            <!-- Visual instructions box -->
            <div class="quick-instruction-card">
              <div class="ins-item">
                <div class="ins-badge">1</div>
                <p>Stage files on the sending device and click <strong>Generate Pair Code</strong>.</p>
              </div>
              <div class="ins-item">
                <div class="ins-badge">2</div>
                <p>Input the numeric code here or scan the QR code with your camera.</p>
              </div>
              <div class="ins-item">
                <div class="ins-badge">3</div>
                <p>Maintain browser tabs active until transfer completes directly peer-to-peer.</p>
              </div>
            </div>
          </div>

          <!-- State 2: Handshake & Transfer Request Pending -->
          <div class="receive-state-zone hidden" id="receive-request-state">
            <h2 class="section-title">Pairing Secured Successfully</h2>
            <p class="section-subtitle">Device has proposed a transfer. Review the file details below.</p>

            <div class="proposed-transfer-hud">
              <div class="proposed-icon-banner">
                <i class="fa-solid fa-share-nodes proposed-icon animate-bounce"></i>
              </div>
              <div class="proposed-summary">
                <p class="proposed-peer-name">Incoming from Peer: <span id="peer-id-display">Connecting...</span></p>
                <h4 class="proposed-files-title"><span id="meta-files-count">0</span> files staged for delivery</h4>
                <p class="proposed-files-weight">Total payload: <span id="meta-files-size">0.00 KB</span></p>
              </div>
              
              <div class="proposed-files-scroller" id="meta-files-list">
                <!-- Staged meta list generated dynamically -->
              </div>
              
              <div class="proposed-decisions">
                <button type="button" class="btn-danger w-half" id="reject-transfer-btn">
                  <i class="fa-solid fa-ban"></i> Reject
                </button>
                <button type="button" class="btn-primary btn-glow w-half" id="accept-transfer-btn">
                  <i class="fa-solid fa-circle-check"></i> Accept & Save
                </button>
              </div>
            </div>
          </div>

        </div>

        <!-- ================= ACTIVE ROOM HUB COMPONENT ================= -->
        <div class="dashboard-card tab-content-pane" id="pane-room-hub">
          <div class="room-hub-header">
            <h2 class="section-title text-teal"><i class="fa-solid fa-circle-check neon-pulse"></i> Connected Room</h2>
            <div class="room-header-meta" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
              <p class="section-subtitle" style="margin-bottom: 0;">Room PIN: <strong class="text-indigo" id="room-pin-display">----</strong> &bull; Share files back and forth continuously.</p>
              
              <!-- Premium Auto-Accept Toggle Switch -->
              <div class="room-action-row" style="display: flex; align-items: center; gap: 8px;">
                <span class="switch-label" style="font-size: 0.75rem; font-weight: 600; color: var(--text-secondary);"><i class="fa-solid fa-bolt mr-xs text-teal"></i> Auto-Accept</span>
                <label class="switch-container" style="position: relative; display: inline-block; width: 34px; height: 20px;">
                  <input type="checkbox" id="auto-accept-toggle" checked style="opacity: 0; width: 0; height: 0;">
                  <span class="switch-slider" style="position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(255,255,255,0.06); border: 1px solid var(--card-border); transition: .3s; border-radius: 20px;"></span>
                </label>
              </div>
            </div>
          </div>

          <!-- Staged files dropzone for active room -->
          <div class="room-send-zone">
            <!-- Compact Drag & Drop Zone -->
            <div class="dropzone-container" id="dropzone-room">
              <input type="file" id="file-input-room" class="hidden-input" multiple>
              <input type="file" id="folder-input-room" class="hidden-input" webkitdirectory directory multiple>
              
              <div class="dropzone-inner">
                <div class="dropzone-icon-glow">
                  <i class="fa-solid fa-paper-plane dropzone-icon"></i>
                </div>
                <h3 class="dropzone-title">Drag & Drop Files to Send</h3>
                <p class="dropzone-desc">Stage files to send instantly over this secure P2P tunnel</p>
                
                <div class="dropzone-actions">
                  <button type="button" class="btn-secondary" id="select-files-btn-room">
                    <i class="fa-solid fa-files"></i> Select Files
                  </button>
                  <button type="button" class="btn-secondary" id="select-folders-btn-room">
                    <i class="fa-solid fa-folder-open"></i> Select Folder
                  </button>
                </div>
              </div>
            </div>

            <!-- Staged Files list inside Room -->
            <div class="staged-container hidden" id="staged-container-room">
              <div class="staged-header">
                <h4>Staged in Room (<span id="staged-count-room">0</span>)</h4>
                <button type="button" class="clear-btn" id="clear-staged-btn-room">Clear All</button>
              </div>
              
              <div class="staged-files-list" id="staged-files-list-room">
                <!-- Staged files rendered dynamically -->
              </div>
              
              <div class="staged-summary-bar">
                <div class="staged-total-info">
                  <span class="total-label">Payload Volume:</span>
                  <span class="total-val" id="staged-total-size-room">0.00 KB</span>
                </div>
                
                <button type="button" class="btn-primary btn-glow" id="send-files-btn-room">
                  <i class="fa-solid fa-bolt"></i> Send to Peer
                </button>
              </div>
            </div>
          </div>

          <div class="room-footer mt-lg">
            <button type="button" class="btn-danger-outline w-full" id="leave-room-btn">
              <i class="fa-solid fa-door-open"></i> Disconnect & Leave Room
            </button>
          </div>
        </div>

      </div>

    </main>

    <!-- History Drawer Overlay -->
    <div class="history-drawer-backdrop" id="history-backdrop"></div>
    <div class="history-drawer" id="history-drawer">
      <div class="drawer-header">
        <h3><i class="fa-solid fa-history mr-sm"></i> Transfer Log</h3>
        <button id="close-history-btn" class="close-drawer-btn">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      
      <div class="drawer-content">
        <div class="history-empty" id="history-empty-view">
          <i class="fa-solid fa-folder-open empty-icon"></i>
          <p>No logged transfers in this session.</p>
        </div>
        <div class="history-items-list hidden" id="history-items-list">
          <!-- Populated by script -->
        </div>
      </div>
      
      <div class="drawer-footer">
        <button type="button" class="btn-secondary w-full" id="clear-history-btn">
          <i class="fa-solid fa-trash-can mr-sm"></i> Clear History
        </button>
      </div>
    </div>

    <!-- Incoming Transfer Proposal Modal Overlay -->
    <div class="history-drawer-backdrop" id="proposal-backdrop"></div>
    <div class="dashboard-card hidden" id="proposal-modal" style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1000; width: 90%; max-width: 440px; box-shadow: var(--glass-shadow);">
      <h2 class="section-title text-teal"><i class="fa-solid fa-share-nodes animate-bounce"></i> Staged Files Proposed</h2>
      <p class="section-subtitle">A peer in this room is offering a new transfer. Review files below:</p>

      <div class="proposed-transfer-hud" style="margin-top: 10px;">
        <div class="proposed-summary" style="text-align: center; margin-bottom: 12px;">
          <h4 class="proposed-files-title"><span id="prop-count">0</span> files staged</h4>
          <p class="proposed-files-weight">Total payload size: <span id="prop-size">0.00 KB</span></p>
        </div>
        
        <div class="proposed-files-scroller" id="prop-files-list" style="max-height: 140px; overflow-y: auto; background: rgba(0, 0, 0, 0.2); border: 1px solid rgba(255, 255, 255, 0.04); border-radius: var(--border-radius-md); padding: 10px; margin-bottom: 18px; display: flex; flex-direction: column; gap: 6px;">
          <!-- Files list -->
        </div>
        
        <div class="proposed-decisions" style="display: flex; gap: 12px;">
          <button type="button" class="btn-danger w-half" id="prop-reject-btn">
            <i class="fa-solid fa-ban"></i> Decline
          </button>
          <button type="button" class="btn-primary btn-glow w-half" id="prop-accept-btn">
            <i class="fa-solid fa-circle-check"></i> Accept & Save
          </button>
        </div>
      </div>
    </div>

    <!-- Pairing QR Code Scanner Modal Overlay -->
    <div class="history-drawer-backdrop" id="qr-scanner-backdrop"></div>
    <div class="dashboard-card hidden" id="qr-scanner-modal" style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1005; width: 90%; max-width: 440px; box-shadow: var(--glass-shadow); padding: 24px;">
      <h2 class="section-title text-teal" style="display: flex; align-items: center; gap: 8px;"><i class="fa-solid fa-qrcode"></i> Scan Pairing QR Code</h2>
      <p class="section-subtitle">Align the QR code on the sending device inside the camera frame.</p>

      <div class="scanner-preview-box" style="position: relative; width: 100%; height: 260px; background: rgba(0,0,0,0.4); border-radius: var(--border-radius-md); overflow: hidden; border: 1px solid rgba(255,255,255,0.08); margin: 16px 0;">
        <div id="qr-reader" style="width: 100%; height: 100%; border: none;"></div>
        <div class="scanner-laser" style="position: absolute; top: 0; left: 0; width: 100%; height: 2px; background: linear-gradient(to right, transparent, var(--accent-teal, #14b8a6), transparent); box-shadow: 0 0 8px var(--accent-teal, #14b8a6); animation: scanLaser 2s linear infinite; z-index: 10; pointer-events: none;"></div>
      </div>

      <div class="proposed-decisions" style="display: flex; gap: 12px; margin-top: 10px;">
        <button type="button" class="btn-danger w-full" id="close-qr-scanner-btn">
          <i class="fa-solid fa-xmark"></i> Cancel Scan
        </button>
      </div>
    </div>

    <!-- Universal Transfer HUD Dialog Modal Overlay -->
    <div class="history-drawer-backdrop" id="hud-backdrop"></div>
    <div class="dashboard-card hidden" id="transfer-hud" style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1010; width: 90%; max-width: 440px; box-shadow: var(--glass-shadow); backdrop-filter: blur(28px); -webkit-backdrop-filter: blur(28px);">
      <div class="hud-connection-bar">
        <div class="hud-peer-name">
          <i class="fa-solid fa-server-network mr-sm text-teal"></i>
          Active Peer Link: <span id="hud-active-peer">Device</span>
        </div>
        <div class="hud-transfer-badge" id="hud-method-badge">
          <i class="fa-solid fa-bolt mr-xs"></i> P2P DIRECT
        </div>
      </div>

      <div class="hud-visual-progress-block">
        <!-- Circular SVG Tracker -->
        <div class="progress-ring-wrapper">
          <svg class="progress-ring" width="140" height="140">
            <circle class="progress-ring-circle-bg" stroke="rgba(255,255,255,0.04)" stroke-width="6" fill="transparent" r="60" cx="70" cy="70" />
            <circle class="progress-ring-circle-bar" id="hud-circle-fill" stroke="var(--accent-blue)" stroke-width="6" stroke-dasharray="376.99" stroke-dashoffset="376.99" fill="transparent" r="60" cx="70" cy="70" />
          </svg>
          <div class="progress-ring-inner">
            <span class="progress-ring-percentage" id="hud-percentage-txt">0%</span>
            <span class="progress-ring-label" id="hud-action-label">Streaming</span>
          </div>
        </div>
      </div>

      <div class="hud-statistics-grid">
        <div class="hud-stat-box">
          <span class="hud-stat-label">Active Speed</span>
          <span class="hud-stat-value text-teal" id="hud-stat-speed">0.00 KB/s</span>
        </div>
        <div class="hud-stat-box">
          <span class="hud-stat-label">Delivered Volume</span>
          <span class="hud-stat-value" id="hud-stat-delivered">0.00 KB / 0.00 KB</span>
        </div>
        <div class="hud-stat-box">
          <span class="hud-stat-label">ETA / Elapsed</span>
          <span class="hud-stat-value" id="hud-stat-eta">00:00 / 00:00</span>
        </div>
      </div>

      <div class="hud-linear-status-bar">
        <div class="linear-bar-track">
          <div class="linear-bar-fill" id="hud-linear-fill" style="width: 0%;"></div>
        </div>
      </div>

      <div class="hud-file-transferring-list" id="hud-active-file-item">
        <!-- Active transferring file status displays here -->
      </div>

      <div class="hud-action-controls">
        <button type="button" class="btn-danger w-full" id="cancel-transfer-btn">
          <i class="fa-solid fa-stop"></i> Cancel Transfer
        </button>
      </div>
    </div>

    <!-- Notification Toast Host -->
    <div class="toast-container" id="toast-container"></div>
  </div>

  <!-- Socket.IO library -->
  <script src="/socket.io/socket.io.js"></script>
  <!-- Expose discovered local server IP for offline QR code pairing -->
  <script>
    window.localServerIp = "<%= localIp %>";
  </script>
  <!-- HTML5 QR Code Scanner Library -->
  <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
  <!-- Main Application Logic Script -->
  <script src="/js/script.js"></script>
</body>
</html>
