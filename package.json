{
  "name": "9.-sw-here",
  "version": "1.0.0",
  "description": "",
  "main": "main-electron.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "electron": "npx electron .",
    "build-app": "electron-builder --win",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "ejs": "^5.0.2",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1"
  },
  "build": {
    "appId": "com.swhere.app",
    "productName": "SW-HERE",
    "win": {
      "icon": "public/images/sw-here-logo.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SW-HERE"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
